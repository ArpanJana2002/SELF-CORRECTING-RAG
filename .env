# --- Choose ONE LLM provider ---
LLM_PROVIDER=anthropic          # "anthropic" or "openai"
ANTHROPIC_API_KEY=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
ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Embeddings ---
# "local" uses a free HuggingFace sentence-transformers model (no API key, runs on CPU)
# "openai" uses OpenAI text-embedding-3-small (needs OPENAI_API_KEY)
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Web search fallback (corrective step) ---
# Get a free key at https://tavily.com
TAVILY_API_KEY=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

# --- Vector store ---
CHROMA_PERSIST_DIR=./vectorstore
CHROMA_COLLECTION_NAME=self_correcting_rag

# --- Retrieval / self-correction tuning ---
RETRIEVAL_K=4
MAX_CORRECTION_LOOPS=3
